  local date=$(date +%Y-%m-%d)
  local journal_dir="/home/marcus/Mainframe/Journal/01 Daily"
  local file="$journal_dir/$date.md"

  if [[ ! -f "$file" ]]; then
    mkdir -p "$journal_dir"
    cat > "$file" << EOF
---
journal: Daily
journal-date: $date
---
-
EOF
  fi

  nvim "+normal G$" "$file"
}

